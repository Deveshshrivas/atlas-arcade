# Server Port
PORT=5000

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster address with your own from MongoDB Atlas:
# Example: mongodb+srv://myUser:mySecretPassword@cluster0.abcde.mongodb.net/auth_demo?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/auth_demo?retryWrites=true&w=majority

# JWT Secret Key for signing authentication tokens
JWT_SECRET=super_secret_jwt_key_change_me_in_production
